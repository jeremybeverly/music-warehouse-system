# ============================================================
# Music Warehouse System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# ============================================================

# --- MongoDB Atlas ---
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# Name of the MongoDB database to use
MONGO_DATABASE_NAME=music_warehouse

# --- Flask ---
# Generate a strong random key, e.g:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ganti_dengan_secret_key_acak_yang_panjang

# --- JWT ---
# Use a different key from FLASK_SECRET_KEY
JWT_SECRET_KEY=ganti_dengan_jwt_secret_key_acak_yang_panjang
